@page "/menu"
@using GoodHamburger.Blazor.Components.Common
@using GoodHamburger.Blazor.Models
@using GoodHamburger.Blazor.Services
@inject GoodHamburger.Blazor.Services.MenuApiService MenuApiService
@inject NavigationManager Navigation

<PageTitle>Cardápio</PageTitle>

<h1>🍔 Cardápio</h1>

@if (_loading)
{
    <p>Carregando cardápio...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <ErrorBox 
        Message="@_error"
        OnRetry="LoadMenuAsync"
        OnBack="GoHome" />
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Tipo</th>
                        <th>Preço</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in _menu.Items)
                    {
                        <tr>
                            <td>@product.Description</td>
                            <td><span class="badge text-bg-secondary">@product.Type</span></td>
                            <td>@product.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted mt-3">Página @_menu.Page de @_menu.TotalPages — Total: @_menu.TotalItems</p>
}

@code {
    private bool _loading = true;
    private string? _error;
    private PagedResult<ProductResult> _menu = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _menu = await MenuApiService.GetMenuAsync(page: 1, pageSize: 20);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMenuAsync()
    {
        try
        {
            _loading = true;
            _error = null;
            _menu = await MenuApiService.GetMenuAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
